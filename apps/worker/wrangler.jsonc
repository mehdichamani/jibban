{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jibban-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    { "pattern": "jibban-api.ajbv.ir", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jibban-db",
      "database_id": "4cb696db-3a9b-4b8d-a5ae-c051523f8666"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "f6b0c489154d4503ab2a087ef540f634"
    }
  ]
}
